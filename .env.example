# Django Environment Configuration
DJANGO_SECRET_KEY=change-me-to-a-secure-random-key-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.trycloudflare.com

# Database Selection: Set USE_SQLITE=True for local sqlite fallback, False for PostgreSQL/Supabase
USE_SQLITE=False

# Supabase Connection Pooler (IPv4 — required for Docker)
# Get these from: Supabase Dashboard > Project > Connect > Session Pooler
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your_supabase_db_password
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require

# Supabase Platform API Credentials
# Get from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Celery & Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# CSRF Trusted Origins (Cloudflare Tunnels, Ngrok, etc.)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.trycloudflare.com

# Routing Provider (mock, osrm)
ROUTING_PROVIDER=mock

# ImageKit.io — Photo CDN
# Get from: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_ID=your_imagekit_id
